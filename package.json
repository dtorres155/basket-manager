{
  "name": "basket-manager",
  "version": "0.9.0",
  "description": "Juego de gestión de baloncesto (NBA, Euroliga, EuroCup, BCL y ligas europeas) 2026-27, en un único index.html",
  "scripts": {
    "build": "node build.js",
    "test": "node test_all.js",
    "test:rapido": "node test_all.js --rapido",
    "modelos": "node tools/modelos_presupuesto.js --optimizar",
    "calidad": "node tools/calidad.js",
    "calidad:rapido": "node tools/calidad.js --rapido",
    "serve": "node serve.js",
    "vendor:three": "node tools/vendor_three.js",
    "test:visual": "node tools/test_visual.js",
    "lint": "eslint .",
    "formato": "prettier --write \"*.js\" \"tools/*.js\"",
    "formato:comprobar": "prettier --check \"*.js\" \"tools/*.js\""
  },
  "dependencies": {
    "jsdom": "^24.1.3"
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/doto": "^5.3.0",
    "@fontsource/graduate": "^5.3.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "lz-string": "^1.5.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.10",
    "three": "^0.186.1"
  }
}
